# Database (Neon DB — use pooled URL for DATABASE_URL, direct for DIRECT_URL)
DATABASE_URL="postgresql://user:password@host/hisobkit?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@host/hisobkit?sslmode=require"

# JWT
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"
JWT_EXPIRES_IN="7d"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# Telegram Bot
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"

# App
PORT=3000
NODE_ENV="development"
FRONTEND_URL="http://localhost:5173"
